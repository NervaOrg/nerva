[Unit]
Description=Rebuild the Nerva CI cloud-agent snapshot and delete old ones (decision O6)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nerva-ci/ci/autoscaler/nerva-autoscaler-image.sh build
# The autoscaler reads the snapshot id when it starts: servers created after this restart use the new one.
# This runs only when the build succeeded (a failed ExecStart skips ExecStartPost), that is, only when there is a new
# snapshot id (every build makes one) to pick up. try-restart: only if the owner left it running (a stopped autoscaler stays stopped); the leading - keeps
# a failed restart from failing the build. It comes before the prune, so the old snapshot is not in use.
ExecStartPost=-/usr/bin/systemctl try-restart nerva-autoscaler.service
ExecStartPost=/usr/local/lib/nerva-ci/ci/autoscaler/nerva-autoscaler-image.sh prune
# After a restart, which ends the autoscaler without a goodbye: warn (NRV-W1208, in the journal) of a server it left.
ExecStartPost=-/usr/local/lib/nerva-ci/ci/autoscaler/nerva-autoscaler.sh check
TimeoutStartSec=2h
